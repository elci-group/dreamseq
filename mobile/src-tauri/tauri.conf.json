{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dreamseq Mobile",
  "version": "0.1.0",
  "identifier": "pro.dreamsequence.mobile",
  "build": {
    "beforeDevCommand": "cd ../ && npm run dev",
    "beforeBuildCommand": "cd ../ && npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dreamseq Mobile",
        "width": 400,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {}
}
